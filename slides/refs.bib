
@article{gershmanCausalImplicaturesCorrelational2023,
	title = {Causal implicatures from correlational statements},
	volume = {18},
	issn = {1932-6203},
	url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC10194916/},
	doi = {10.1371/journal.pone.0286067},
	abstract = {Correlation does not imply causation, but this does not necessarily stop people from drawing causal inferences from correlational statements. We show that people do in fact infer causality from statements of association, under minimal conditions. In Study 1, participants interpreted statements of the form “X is associated with Y” to imply that Y causes X. In Studies 2 and 3, participants interpreted statements of the form “X is associated with an increased risk of Y” to imply that X causes Y. Thus, even the most orthodox correlational language can give rise to causal inferences.},
	pages = {e0286067},
	number = {5},
	journaltitle = {{PLOS} {ONE}},
	shortjournal = {{PLoS} One},
	author = {Gershman, Samuel J. and Ullman, Tomer D.},
	urldate = {2025-03-17},
	date = {2023-05-18},
	pmid = {37200364},
	pmcid = {PMC10194916},
	file = {PubMed Central Full Text PDF:/home/susan/Nextcloud/Zotero/storage/D9H7YJ62/Gershman and Ullman - 2023 - Causal implicatures from correlational statements.pdf:application/pdf},
}

@article{elvikSimpsonsParadoxCollection2025,
  title = {Simpson's Paradox: {{A}} Collection of Examples from Road Safety Studies and Emergency Medicine},
  shorttitle = {Simpson's Paradox},
  author = {Elvik, Rune},
  year = 2025,
  month = may,
  journal = {Transportation Research Interdisciplinary Perspectives},
  volume = {31},
  pages = {101471},
  issn = {2590-1982},
  doi = {10.1016/j.trip.2025.101471},
  urldate = {2026-08-31},
  abstract = {Simpson's paradox, first described in 1951, denotes a reversal of a difference or ratio when data for several groups are added up. This paper illustrates the paradox by means of examples taken from road safety studies and emergency medicine. These examples are only intended to show how the paradox can arise. It is not known how common the paradox is or how often it goes undetected. If undetected, it can lead to erroneous conclusions, for example that women have a higher accident rate than men, when in each group formed according to annual driving distance the opposite is the case. The reversal of the difference occurs because there is an interaction between gender, driving distance and accident rate. Women drive shorter than men, and shorter driving distances are associated with higher accident rates than longer driving distances.},
  keywords = {Effect reversal,Emergency medicine,Road safety,Simpson's paradox},
  file = {/home/susan/.Zotero-data/storage/7TVC8K9Z/Elvik - 2025 - Simpson’s paradox A collection of examples from road safety studies and emergency medicine.pdf;/home/susan/.Zotero-data/storage/FS3L6JXH/S2590198225001502.html}
}
